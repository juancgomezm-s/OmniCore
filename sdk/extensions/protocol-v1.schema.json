{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnicore.local/extensions/1.0",
  "title": "OmniCore Extension RPC 1.0",
  "x-maximumFrameBytes": 262144,
  "type": "object",
  "required": ["jsonrpc", "id"],
  "properties": {
    "jsonrpc": { "const": "2.0" }, "id": { "type": "string", "maxLength": 128 },
    "method": { "type": "string", "maxLength": 128 }, "params": { "type": "object" },
    "result": {}, "error": { "type": "object" }
  },
  "oneOf": [{ "required": ["method", "params"] }, { "required": ["result"] }, { "required": ["error"] }],
  "$defs": {
    "initialize": { "type": "object", "required": ["protocolVersion", "extensionId", "capabilities", "sessionId"],
      "properties": { "protocolVersion": { "const": "1.0" }, "extensionId": { "type": "string" },
        "capabilities": { "type": "array", "maxItems": 64, "items": { "type": "string" } }, "sessionId": { "type": ["string", "null"] } } },
    "view": { "type": "object", "x-coreView": true, "required": ["id", "extensionId", "kind", "revision", "state", "items", "actions"],
      "$comment": "x-coreView is the published semantic profile implemented by schema-validation.mjs and ExtensionProtocol.Decode: unique IDs, typed defaults, readonly/action rules and UTF-16 bounds. Generic JSON Schema validators check structural constraints only.",
      "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" }, "extensionId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "kind": { "enum": ["tree", "list", "table", "form", "indicator", "details"] },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "state": { "enum": ["ready", "partial", "unsupported", "error"] }, "reset": { "type": "boolean", "default": true },
        "items": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/item" } }, "actions": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/action" } },
        "scope": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/scope" }] },
        "removedIds": { "type": ["array", "null"], "maxItems": 256, "items": { "type": "string" } },
        "itemOrder": { "type": ["array", "null"], "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "maxLength": 1024 } },
        "columns": { "type": ["array", "null"], "maxItems": 32, "items": { "$ref": "#/$defs/column" } },
        "fields": { "type": ["array", "null"], "maxItems": 64, "items": { "$ref": "#/$defs/field" } },
        "indicators": { "type": ["array", "null"], "maxItems": 64, "items": { "$ref": "#/$defs/indicator" } } } },
    "scope": { "type": "object", "required": ["workspaceId", "sessionId", "manifestSha256", "packageSha256"],
      "properties": { "workspaceId": { "type": "string" }, "sessionId": { "type": ["string", "null"] },
        "manifestSha256": { "type": "string" }, "packageSha256": { "type": "string" }, "snapshotId": { "type": ["string", "null"] } } },
    "action": { "type": "object", "required": ["id", "label", "requiresUserAuthority"],
      "properties": { "id": { "type": "string", "maxLength": 128 }, "label": { "type": "string", "maxLength": 2048 },
        "requiresUserAuthority": { "type": "boolean" }, "itemId": { "type": ["string", "null"] },
        "configurationKey": { "type": ["string", "null"], "maxLength": 80 }, "configurationScope": { "enum": ["workspace", "user", "session"] },
        "enabled": { "type": "boolean" }, "disabledReason": { "type": ["string", "null"] } } },
    "formSubmission": { "type": "object", "required": ["extensionId", "viewId", "actionId", "expectedRevision", "scope", "values"],
      "properties": { "extensionId": { "type": "string" }, "viewId": { "type": "string" }, "actionId": { "type": "string" },
        "expectedRevision": { "type": "integer", "minimum": 1 }, "scope": { "$ref": "#/$defs/scope" }, "values": { "type": "object", "maxProperties": 64 },
        "path": { "type": "string", "maxLength": 1024 }, "search": { "type": "string", "maxLength": 256 } } },
    "activityPage": { "type": "object", "required": ["sessionId", "nextSequence", "highWater", "gap", "items"],
      "properties": { "sessionId": { "type": ["string", "null"] }, "nextSequence": { "type": "integer", "minimum": 0 },
        "highWater": { "type": "integer", "minimum": 0 }, "gap": { "type": "boolean" },
        "earliestAvailableSequence": { "type": ["integer", "null"] }, "items": { "type": "array", "maxItems": 128 } } },
    "item": { "type": "object", "required": ["id", "label"],
      "properties": { "id": { "type": "string", "maxLength": 1024 }, "label": { "type": "string", "maxLength": 2048 },
        "hasChildren": { "type": "boolean" }, "parentId": { "type": ["string", "null"] }, "data": {},
        "cells": { "type": ["object", "null"], "maxProperties": 32 } } },
    "column": { "type": "object", "required": ["id", "label"],
      "properties": { "id": { "type": "string", "maxLength": 80 }, "label": { "type": "string", "maxLength": 240 },
        "valueType": { "enum": ["text", "number", "boolean"] }, "alignment": { "enum": ["left", "center", "right"] } } },
    "field": { "type": "object", "required": ["id", "label", "kind"],
      "properties": { "id": { "type": "string", "maxLength": 80 }, "label": { "type": "string", "maxLength": 240 },
        "kind": { "enum": ["text", "number", "boolean", "choice"] }, "value": {}, "required": { "type": "boolean" },
        "readOnly": { "type": "boolean" }, "options": { "type": ["array", "null"], "uniqueItems": true, "maxItems": 128, "items": { "type": "string", "maxLength": 240, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$" } } },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "text" } } }, "then": { "properties": { "value": { "type": ["string", "null"], "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$" } } } },
        { "if": { "properties": { "kind": { "const": "number" } } }, "then": { "properties": { "value": { "type": ["number", "null"] } } } },
        { "if": { "properties": { "kind": { "const": "boolean" } } }, "then": { "properties": { "value": { "type": ["boolean", "null"] } } } },
        { "if": { "properties": { "kind": { "const": "choice" } } }, "then": { "required": ["options"], "properties": { "value": { "type": ["string", "null"] }, "options": { "type": "array", "minItems": 1 } } } }
      ] },
    "indicator": { "type": "object", "required": ["id", "label", "state"],
      "properties": { "id": { "type": "string", "maxLength": 80 }, "label": { "type": "string", "maxLength": 240 },
        "state": { "enum": ["unknown", "ready", "active", "warning", "error"] }, "value": { "type": ["number", "null"] }, "unit": { "type": ["string", "null"] } } }
  }
}
