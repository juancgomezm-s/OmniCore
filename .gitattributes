* text=auto
*.cs      text diff=csharp
*.csproj  text
*.slnx    text
*.props   text
*.md      text
*.json    text
*.ps1     text eol=crlf
*.sh      text eol=lf

# Preserve shared Rust source snapshots across Windows/Linux checkouts.
/native/desktop-engine/** text eol=lf

# Keep upstream license texts byte-for-byte, including their original whitespace.
/native/desktop-control/licenses/** whitespace=-blank-at-eol,-blank-at-eof
