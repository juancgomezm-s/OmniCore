<Project Sdk="Microsoft.NET.Sdk">

  <!-- Multi-target: compartida con OmniCoder (net8) sin exigirle migrar (ADR-0038 §6). No usar APIs exclusivas de net10. -->
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>OmniCore.Sandbox</PackageId>
    <Description>Aislamiento de procesos y fronteras de rutas (Windows: AppContainer y Job Objects; Linux: bubblewrap/Landlock/seccomp). Compartida con OmniCoder; no depende de ningún otro proyecto OmniCore.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniCore.Tests" />
  </ItemGroup>

  <Target Name="CompileLinuxSandboxHelper" Condition="$([MSBuild]::IsOSPlatform('Linux'))"
          Inputs="$(MSBuildProjectDirectory)/native/linux_sandbox.c"
          Outputs="$(IntermediateOutputPath)native/omnicore-linux-sandbox">
    <Error Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != '$(NETCoreSdkRuntimeIdentifier)'"
           Text="Build the Linux sandbox helper on the target architecture; cross-publishing an incorrect native helper is not supported." />
    <MakeDir Directories="$(IntermediateOutputPath)native" />
    <Exec Command="cc -std=c11 -O2 -Wall -Wextra -Werror -D_FORTIFY_SOURCE=2 &quot;$(MSBuildProjectDirectory)/native/linux_sandbox.c&quot; -o &quot;$(IntermediateOutputPath)native/omnicore-linux-sandbox&quot;" />
  </Target>
  <Target Name="IncludeLinuxSandboxHelper" BeforeTargets="AssignTargetPaths"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))" DependsOnTargets="CompileLinuxSandboxHelper">
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)native/omnicore-linux-sandbox"
               Link="omnicore-linux-sandbox" CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
