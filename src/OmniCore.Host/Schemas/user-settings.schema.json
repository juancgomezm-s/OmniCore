{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniCore User settings.yaml",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": { "type": "string", "enum": ["es", "en", "fr", "it"], "default": "es" }
      }
    },
    "sidebar": { "$ref": "#/$defs/sidebar" },
    "widgets": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z0-9._-]{1,100}$" }, "additionalProperties": { "$ref": "#/$defs/widget" } },
    "defaultModel": { "type": "string", "description": "Must name a user-defined model alias." },
    "gates": { "$ref": "#/$defs/gates" },
    "languageServers": {
      "type": "object", "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Za-z0-9._-]{1,64}$" },
      "additionalProperties": { "$ref": "#/$defs/languageServer" },
      "description": "User-owned literal stdio language-server commands. Never place secrets in args."
    },
    "locked": {
      "type": "array",
      "uniqueItems": true,
      "description": "Keys no more-specific scope (Project, Workspace) can change; a section locks every key below it.",
      "items": { "type": "string", "pattern": "^(defaultModel|gates(\\.(build|test|acceptance))?|sidebar(\\.(visible|mode|stackedMinWidth|tabbedMinWidth))?|widgets(\\.[A-Za-z0-9._-]{1,100})?)$" }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": { "type": "number", "minimum": 0, "default": 5 },
        "daily": { "type": "number", "minimum": 0, "default": 20 }
      }
    }
  },
  "$defs": {
    "languageServer": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "languageId", "extensions"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "languageId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "extensions": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]{1,15}$" } }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Literal argv; first item is executable." },
        "test": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Literal argv; first item is executable." },
        "acceptance": { "type": "boolean" }
      }
    },
    "sidebar": { "type": "object", "additionalProperties": false, "properties": {
      "visible": { "type": "boolean" }, "mode": { "enum": ["auto", "stacked", "tabbed", "overlay"] },
      "stackedMinWidth": { "type": "integer", "minimum": 50, "maximum": 500 },
      "tabbedMinWidth": { "type": "integer", "minimum": 50, "maximum": 500 }
    } },
    "widget": { "type": "object", "additionalProperties": false, "properties": {
      "visible": { "enum": [true, false, "true", "false", "auto"] }, "expanded": { "type": "boolean" },
      "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 }
    } }
  }
}
