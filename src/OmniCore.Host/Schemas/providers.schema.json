{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniCore user providers.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providers"
  ],
  "properties": {
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "baseUrl"
        ],
        "not": {
          "required": [
            "auth",
            "authRef"
          ]
        },
        "properties": {
          "kind": {
            "enum": [
              "openAiChatCompatible",
              "openAiResponses",
              "anthropicMessages",
              "llamaCpp",
              "ikLlama"
            ]
          },
          "family": {
            "enum": [
              "OpenAiChatCompatible",
              "OpenAIResponses",
              "AnthropicMessages"
            ]
          },
          "baseUrl": {
            "oneOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              {
                "const": "auto"
              }
            ]
          },
          "host": {
            "type": "string",
            "enum": [
              "attach",
              "managed"
            ]
          },
          "managed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executable"
            ],
            "properties": {
              "executable": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "workingDirectory": {
                "type": "string"
              },
              "readinessTimeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            }
          },
          "caCertificate": {
            "type": "string"
          },
          "authRef": {
            "type": "string",
            "description": "Secret reference (preferred form)."
          },
          "auth": {
            "description": "Deprecated legacy authentication syntax. Prefer authRef.",
            "oneOf": [
              {
                "const": "none"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "apiKey"
                ],
                "properties": {
                  "apiKey": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "profile": {
            "type": "string",
            "enum": [
              "api",
              "codex"
            ],
            "description": "Perfil dentro de la familia; codex = suscripción ChatGPT (solo OpenAIResponses)"
          },
          "billingMode": {
            "type": "string",
            "enum": [
              "Unknown",
              "Local",
              "IncludedQuota",
              "CreditBalance",
              "MeteredCurrency"
            ],
            "description": "Declaración explícita de facturación del proveedor; sin valor se trata como Unknown."
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "host"
              ]
            },
            "then": {
              "properties": {
                "family": {
                  "const": "OpenAiChatCompatible"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "host": {
                  "const": "managed"
                }
              },
              "required": [
                "host"
              ]
            },
            "then": {
              "required": [
                "managed"
              ]
            }
          },
          {
            "if": {
              "required": [
                "managed"
              ]
            },
            "then": {
              "required": [
                "host"
              ],
              "properties": {
                "host": {
                  "const": "managed"
                }
              }
            }
          },
          {
            "if": {
              "not": {
                "properties": {
                  "host": {
                    "const": "managed"
                  }
                },
                "required": [
                  "host"
                ]
              }
            },
            "then": {
              "properties": {
                "baseUrl": {
                  "not": {
                    "const": "auto"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
