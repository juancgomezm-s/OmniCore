{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniCore user models.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["models"],
  "properties": {
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "context": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "recommendedUsableContext": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "maxOutput": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "parametersBillions": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "reasoning": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "supported": { "type": "boolean" },
              "effortLevels": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
              "replayPolicy": { "type": "string", "enum": ["None", "ProviderManaged", "RequiredWithTools", "PreserveAcrossSteps"] },
              "ultraCodeBudgetTokens": { "type": "integer", "minimum": 1024 },
              "ultraCodeOutputReserveTokens": { "type": "integer", "minimum": 1 }
            },
            "allOf": [
              { "if": { "required": ["effortLevels"] }, "then": { "required": ["supported"], "properties": { "supported": { "const": true } } } },
              { "if": { "anyOf": [{ "required": ["ultraCodeBudgetTokens"] }, { "required": ["ultraCodeOutputReserveTokens"] }] }, "then": {
                "required": ["supported", "effortLevels", "ultraCodeBudgetTokens", "ultraCodeOutputReserveTokens"],
                "properties": { "supported": { "const": true }, "effortLevels": { "contains": { "const": "budget" } } }
              } }
            ]
          }
        }
      }
    }
  }
}
