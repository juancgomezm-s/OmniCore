<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Distribución self-contained por RID con Native AOT como opción (ADR-0038):
       los analizadores de trimming/AOT están activos desde M1 para no introducir código incompatible. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
